# Database Configuration
DATABASE_URL=sqlite:///./evergreen.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/evergreen

# Twitter API Configuration
TWITTER_BEARER_TOKEN=your_bearer_token_here
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here

# Instagram Configuration
INSTAGRAM_USERNAME=your_username_here
INSTAGRAM_PASSWORD=your_password_here

# LinkedIn Configuration
LINKEDIN_API_KEY=your_api_key_here

# Application Settings
APP_NAME=Evergreen Content Tracker
SYNC_INTERVAL_HOURS=6

# Security
ENCRYPTION_KEY=your_encryption_key_here

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api
